localId = 'Juno/WAV/Survey'
description = 'Survey Mode Electric or Magnetic Spectral Densities'

reader = 'waves_pds_srvrdr -l error flight'
das2Stream = 1

; Implicit X time coordinate added by default

; Specify Y coordinate, elements are: name, axis, units, [title]
coord_01 = 'frequency | Y | Hz'

; Specify data items, elements are: name in stream, axis, units, title, [enabled]
data_01 = 'specdens | Z | V**2 m**-2 Hz**-1 | Electric Spectral Density'

readAccess = 'age:6m|GROUP:juno'
securityRealm = 'Juno Magnetospheric Working Group'

validRange = '2010-09-01T00:00:00 to now'

techContact = 'Chris Piker <chris-piker@uiowa.edu>'
sciContact = 'Bill Kurth <william-kurth@uiowa.edu>'

param_00 = 'ASCII | If specified, output is in UTF-8 format'
param_01 = 'KEEP-SPIKES | If specified single LFR packets with a pre-amp toggle are retained in the output'
param_02 = 'XMAS | If specified only output the Xmas flag'
param_03 = 'B    | Only output magnetic data from the low-band of the Low Frequency Receiver'
param_04 = 'LFRL | Only output electric from the low-band of the Low Frequency Receiver'
param_05 = 'LFRH | Only output data from the high-band of the Low Frequency Receiver'
param_06 = 'HFRL | Only output data from the baseband of the High Frequency Receivers'
param_07 = 'HFRH | Only output data from the frequency down-mixed sections of the High Frequency Receivers'


exampleRange_00 = '2018-10-02T11:00 to 2018-10-04T11:00 | Perijove 16'
exampleRange_01 = '2018-08-10T15:00 to 2018-08-12T15:00 | Perijove 15'
exampleRange_02 = '2018-06-18T18:00 to 2018-06-20T18:00 | Perijove 14'
exampleRange_03 = '2018-04-26T20:00 to 2018-04-28T20:00 | Perijove 13'
exampleRange_04 = '2018-03-05T00:00 to 2018-03-07T00:00 | Perijove 12'
exampleRange_05 = '2018-01-11T04:00 to 2018-01-13T04:00 | Perijove 11'
