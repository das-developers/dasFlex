; Identification -------------------------------------------------------------

description = 'Calibrated, full-resolution, low-rate electric survey data (PDS level 3 files)'

techContact = 'Chris Piker <chris-piker@uiowa.edu>'
sciContact  = 'Bill Kurth <william-kurth@uiowa.edu>'

das2Stream  = 1

accessInfo = 'All Cassini data have been delivered to the PDS, passwords '+$
             'and permissions are no longer required but contact with the'+$
				 'RPWS instrument team is advised'

; Associated Sources ---------------------------------------------------------

link_01 = 'overlay|Electron Cyclotron|../MAG/ElectronCyclotron'
link_02 = 'location|Spacecraft location with respect to Saturn|../Ephemeris/Saturn'

; Query Range ----------------------------------------------------------------

validRange  = '1997-01-03T03:15 to 2017-09-15T10:35'

; Query Parameters -----------------------------------------------------------

param_00        = 'options | Many and varied reader options as a string | @'
paramInfo_00    = '-a           - Correct for the antenna resonance in hf2\n'+$
  '-b N         - Background division using the Nth percentile as the background\n'+$
  '-c           - process all sensors as one big conglomeration;  this option is\n'+$
  '                 incompatable with background division.\n'+$
  '-n mfdr_mfr2 - keep only the mfdr frequencies which are within the bandwidth of mfr band 2.\n'+$
  '-n mfr3_hfra - nix the mfr band 3 frequencies which conflict with hfr band A.\n'+$
  '-n hfra_mfr3 - nix the hfr band A frequencies which conflict with mfr band 3.\n'+$
  '-n hfrc_hf1  - nix the hfr band C frequencies which conflict with hfr band HF1.\n'+$
  '-n hf1_hfrc  - nix the hfr band hf1 frequencies which conflict with hfr band C.\n'+$
  '-n hfrc_hf2  - nix the hfr band C frequencies which conflict with hfr band HF2.\n'+$
  '-n hf2_hfrc  - nix the hfr band HF2 frequencies which conflict with hfr band C.\n'+$
  '-n hf1pwr    - nix the hfr band HF1 frequencies that are power supply harmonics, 50Khz.\n'+$
  '-n hf2pwr    - nix the hfr band HF2 frequencies that are power supply harmonics, 50Khz.\n'+$
  '-n bad_data  - corrupted data packets\n'+$
  '-n hfr_snd   - data captured during the hfr sounder\n'+$
  '-n lp_rswp   - data captured during the langmuir probe raw sweep\n'+$
  '-n fake_data - data that was constructed on the gound\n'+$
  '-n dpf_zero  - lfdr/mfdr data which had a digital prescale of zero\n'+$
  '-n bascap    - nix the antenna base capacitance correction\n'+$
  '-n antlen    - nix the antenna length, units are V^2/Hz\n'+$
  '-tStart      - DATE DATE is a string acceptable to parsetime()\n'+$
  '-tStop DATE DATE - is a string acceptable to parsetime()\n'+$
  '-lfdr LHExEzBxByBz\n'+$
  '-mfr 123ExEzBxBz\n'+$
  '-hfr ABC12EuEvExEz\n'+$

; Query Examples --------------------------------------------------------------

exampleRange_00  = '2016-001 to 2016-002'
exampleParams_00 = '-lfdr ExEw -mfdr ExEw -mfr 13ExEw -hfr ABC12EuEvExEw -n hfr_snd'+$
   ' -n lp_rswp -n bad_data -n dpf_zero -n mfdr_mfr2 -n mfr3_hfra -n hf1_hfrc'

; Internal Details -----------------------------------------------------------

reader	   = '/project/cassini/etc/invoke.sh rpws_lr_das2rdr.sh'

; Use default reducer
; No caching supported


